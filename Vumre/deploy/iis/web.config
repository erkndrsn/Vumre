<?xml version="1.0" encoding="utf-8"?>
<!-- Vumre — IIS reverse-proxy → PM2 (localhost:630). Vue arayüzü, /admin ve /api tek Next process'inden gelir. -->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:630/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Umreci doküman yüklemeleri için istek boyutu sınırı: 100 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
